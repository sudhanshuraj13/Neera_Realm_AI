generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id @default(uuid())
  telegramId BigInt   @unique
  firstName  String
  username   String?

  // Google OAuth2 credentials
  googleId          String?   @unique
  accessToken       String?   @db.Text
  refreshToken      String?   @db.Text
  tokenExpiry       DateTime?

  // Google Calendar webhook state
  webhookChannelId  String?
  calendarSyncToken String?

  // Career intelligence (Phase 1 & Phase 2.5 & Phase 4)
  resumeJson         Json?    @db.JsonB   // Extracted raw skills, experience, projects
  isPro              Boolean  @default(false) // Future monetization flag
  experienceLevel    String?  // e.g. "Fresher", "1-3 Years", "Senior"
  targetRoles        String[] @default([]) // e.g. ["Backend", "AI"]
  locationPreference String?  // e.g. "Remote", "India", "US"
  onboardingCompleted Boolean @default(false)
  primaryRole        String?  // Confirmed target primary job title (e.g. "UI/UX Designer")

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  preference UserPreference?
  messages   Message[]
  fundingAlerts UserFundingAlert[]

  @@map("users")
}

model UserPreference {
  id             String   @id @default(uuid())
  userId         String   @unique
  industries     String[] @default(["Finance"])
  watchlist      String[] @default(["AAPL", "NVDA", "TSLA"])
  briefingTime   String   @default("08:00")
  onboardingDone Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

enum MessageRole {
  user
  assistant
}

model Message {
  id        String      @id @default(uuid())
  userId    String
  role      MessageRole
  content   String      @db.Text
  createdAt DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("messages")
}

model FundedStartup {
  id           String   @id @default(cuid())
  companyName  String
  amountRaised String
  fundingStage String
  domain       String
  summary      String   @db.Text
  careersUrl   String?
  sourceUrl    String   @unique
  createdAt    DateTime @default(now())

  sentAlerts UserFundingAlert[]

  @@map("funded_startups")
}

model UserFundingAlert {
  id        String   @id @default(uuid())
  userId    String
  startupId String
  sentAt    DateTime @default(now())

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  startup FundedStartup @relation(fields: [startupId], references: [id], onDelete: Cascade)

  @@unique([userId, startupId])
  @@map("user_funding_alerts")
}
